<%- include('partials/header') %>
<section class="auth">
  <div class="auth-brand"><span class="brand-mark lg" aria-hidden="true"></span><h1><%= appName %></h1></div>
  <form method="post" action="/login" class="card form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <label>ログインID
      <input name="login_id" value="<%= loginId %>" autocomplete="username" autocapitalize="off" required autofocus>
    </label>
    <label>パスワード
      <input name="password" type="password" autocomplete="current-password" required>
    </label>
    <button class="btn btn-primary btn-block" type="submit">ログイン</button>
    <p class="muted small">パスワードを忘れた場合は管理者に再発行を依頼してください。</p>
  </form>
</section>
<%- include('partials/footer') %>
