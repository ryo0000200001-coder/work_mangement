<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' | ' : '' %><%= appName %></title>
  <link rel="stylesheet" href="/static/css/app.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%232563eb'/%3E%3Cpath d='M16 8v8l5 3' stroke='white' stroke-width='3' fill='none' stroke-linecap='round'/%3E%3C/svg%3E">
  <script src="/static/js/app.js" defer></script>
</head>
<body>
<% if (currentUser) { %>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span><%= appName %></a>
    <button class="nav-toggle" type="button" aria-label="メニュー" aria-expanded="false" data-nav-toggle>☰</button>
    <nav class="nav" data-nav>
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">打刻</a>
      <a href="/timesheet" class="<%= currentPath === '/timesheet' ? 'active' : '' %>">勤務表</a>
      <a href="/requests" class="<%= currentPath.startsWith('/requests') ? 'active' : '' %>">申請</a>
      <% if (currentUser.role === 'admin') { %>
        <span class="nav-sep" aria-hidden="true"></span>
        <a href="/admin" class="<%= currentPath === '/admin' || currentPath === '/admin/' ? 'active' : '' %>">本日の状況</a>
        <a href="/admin/requests" class="<%= currentPath.startsWith('/admin/requests') ? 'active' : '' %>">承認<% if (pendingCount) { %><span class="badge"><%= pendingCount %></span><% } %></a>
        <a href="/admin/timesheets" class="<%= currentPath.startsWith('/admin/timesheets') || currentPath.startsWith('/admin/attendance') ? 'active' : '' %>">集計・勤務表</a>
        <details class="nav-more <%= /^\/admin\/(users|leave|holidays|settings|audit)/.test(currentPath) ? 'active' : '' %>">
          <summary>管理</summary>
          <div class="nav-menu">
            <a href="/admin/users">従業員</a>
            <a href="/admin/leave">有給休暇</a>
            <a href="/admin/holidays">休日カレンダー</a>
            <a href="/admin/settings">設定</a>
            <a href="/admin/audit">操作ログ</a>
          </div>
        </details>
      <% } %>
      <span class="nav-spacer"></span>
      <details class="nav-more nav-user">
        <summary><%= currentUser.name %></summary>
        <div class="nav-menu nav-menu-right">
          <span class="nav-menu-note"><%= currentUser.login_id %><%= currentUser.department ? ' / ' + currentUser.department : '' %></span>
          <a href="/account/password">パスワード変更</a>
          <form method="post" action="/logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="link-button">ログアウト</button>
          </form>
        </div>
      </details>
    </nav>
  </div>
</header>
<% } %>
<main class="container">
<% for (const f of flash) { %>
  <div class="alert alert-<%= f.type === 'error' ? 'error' : 'success' %>" role="<%= f.type === 'error' ? 'alert' : 'status' %>"><%= f.message %></div>
<% } %>
