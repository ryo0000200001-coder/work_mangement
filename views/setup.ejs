<%- include('partials/header') %>
<section class="auth">
  <div class="auth-brand"><span class="brand-mark lg" aria-hidden="true"></span><h1>初期セットアップ</h1></div>
  <form method="post" action="/setup" class="card form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p class="muted">最初の管理者アカウントを作成します。この画面は管理者作成後は表示されません。</p>
    <%- include('partials/errors') %>
    <label>会社名（任意）
      <input name="company_name" value="<%= values.company_name || '' %>" maxlength="100">
    </label>
    <label>氏名
      <input name="name" value="<%= values.name || '' %>" required maxlength="100">
    </label>
    <label>ログインID <span class="muted small">半角英数字・. _ @ -</span>
      <input name="login_id" value="<%= values.login_id || '' %>" required autocomplete="username" autocapitalize="off">
    </label>
    <label>パスワード <span class="muted small">8文字以上・英字と数字を含む</span>
      <input name="password" type="password" required autocomplete="new-password" minlength="8">
    </label>
    <label>パスワード（確認）
      <input name="password_confirm" type="password" required autocomplete="new-password" minlength="8">
    </label>
    <button class="btn btn-primary btn-block" type="submit">管理者を作成して開始</button>
  </form>
</section>
<%- include('partials/footer') %>
