<%- include('partials/header') %>
<section class="card narrow">
  <h1>パスワード変更</h1>
  <% if (currentUser.must_change_password) { %>
    <div class="alert alert-info">初回ログインのため、パスワードを変更してください。</div>
  <% } %>
  <%- include('partials/errors') %>
  <form method="post" action="/account/password" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text" name="username" value="<%= currentUser.login_id %>" autocomplete="username" hidden>
    <label>現在のパスワード
      <input name="current_password" type="password" required autocomplete="current-password">
    </label>
    <label>新しいパスワード <span class="muted small">8文字以上・英字と数字を含む</span>
      <input name="new_password" type="password" required minlength="8" autocomplete="new-password">
    </label>
    <label>新しいパスワード（確認）
      <input name="new_password_confirm" type="password" required minlength="8" autocomplete="new-password">
    </label>
    <button class="btn btn-primary" type="submit">変更する</button>
  </form>
</section>
<%- include('partials/footer') %>
